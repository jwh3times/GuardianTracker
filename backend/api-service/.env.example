# API Service Configuration

PORT=8081
# Required; accepts exactly development or production.
GO_ENV=development

# Bungie API
BUNGIE_API_KEY=your_bungie_api_key_here
BUNGIE_API_BASE_URL=https://www.bungie.net/Platform
BUNGIE_CLIENT_ID=your_bungie_client_id_here
BUNGIE_CLIENT_SECRET=your_bungie_client_secret_here
AUTH_REDIRECT_URI=http://localhost:5273/auth/callback

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
# Access tokens expire after this duration; the legacy JWT_EXPIRY_HOURS setting
# is still accepted when JWT_ACCESS_TTL is not set.
JWT_ACCESS_TTL=30m
JWT_REFRESH_EXPIRY_DAYS=30

# Manifest
MANIFEST_DB_PATH=./data/manifest.sqlite
MANIFEST_CHECK_INTERVAL=3600

# Rate Limiting (requests per second to Bungie API)
BUNGIE_API_RPS=10
BUNGIE_API_BURST=20

# Caching
CACHE_ENABLED=true
CACHE_TTL_COLLECTIONS=300

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5273

# Database — inner-loop `go run` connects to the Postgres host port published by
# docker-compose, which is 5532 (offset from the canonical 5432). The container-internal
# port is still 5432, so the full-stack DATABASE_URL in docker-compose.yml uses 5432.
DATABASE_URL=postgres://guardian_app:guardian_dev_password@localhost:5532/guardian_tracker?sslmode=disable

# Token encryption (generate with: openssl rand -base64 32). Versions are
# positive SMALLINT identifiers and must never be reused for different keys.
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_VERSION=1
# Previous encryption key/version (set both only during key rotation)
TOKEN_ENCRYPTION_KEY_PREVIOUS=
TOKEN_ENCRYPTION_KEY_PREVIOUS_VERSION=

# Admin bootstrap — comma-separated Bungie membership IDs pinned to the admin
# role on every login (the only way to mint the first admin). Leave empty for none.
ADMIN_MEMBERSHIP_IDS=

# Audit log retention in days (rows + stored client IPs pruned hourly past this)
AUDIT_RETENTION_DAYS=180
# Comma-separated CIDRs/IPs trusted for X-Forwarded-For client-IP resolution
# (set to the platform ingress range in production; empty trusts none)
TRUSTED_PROXIES=

# Bungie URL overrides — point OAuth pages, the token endpoint, and the
# manifest-zip host at a fake Bungie for hermetic E2E. Defaults (unset) are the
# real bungie.net endpoints; only set these for E2E/dev doubles.
# BUNGIE_AUTHORIZE_URL=https://www.bungie.net/en/OAuth/Authorize
# BUNGIE_TOKEN_URL=https://www.bungie.net/platform/app/oauth/token/
# BUNGIE_CDN_BASE_URL=https://www.bungie.net

# Inbound hardening — per-IP rate limit on the public auth endpoints and a
# global request body cap (bytes). Defaults shown.
# AUTH_RATE_LIMIT_RPS=5
# AUTH_RATE_LIMIT_BURST=10
# MAX_BODY_BYTES=65536
