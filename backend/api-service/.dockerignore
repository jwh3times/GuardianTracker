# Local credentials never belong in a build context, at any directory depth.
**/.env
**/.env.*
**/*.env
**/*.env.*
**/.envrc
# Only the deliberate, value-free root template is retained.
!.env.example
**/*.pem
**/*.key
**/*.crt
**/*.cer
**/*.der
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/id_rsa*
**/id_ed25519*
**/id_ecdsa*
**/id_dsa*
**/.ssh
**/.aws
**/.azure
**/.kube
**/secrets
**/.secrets
**/*.secrets.*
**/certs
**/certificates
**/private
**/.private-workspace

# Runtime data, logs, caches, dependencies, and generated artifacts.
# Runtime data is root-scoped; nested source modules named data are build inputs.
data
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/logs
**/*.log
**/*.log.*
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/.cache
**/coverage
**/*.cover
**/*.coverprofile
**/node_modules
**/dist
**/build
**/tmp
**/temp
**/.tmp
**/*.tmp
**/*.bak
**/*.out
**/*.test
**/*.exe
**/*.tsbuildinfo

# Local tooling and source-control state.
**/.git
**/.gitignore
**/.idea
**/.vscode
**/.DS_Store
**/Thumbs.db
**/*.swp
**/*.swo
**/*~
Dockerfile*
.dockerignore

# API runtime downloads and local hot-reload output.
**/.e2e
**/vendor
.air.toml
main
