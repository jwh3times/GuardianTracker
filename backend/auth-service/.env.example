# Auth Service Configuration

# Server Configuration
PORT=8081
GO_ENV=development

# Bungie OAuth Configuration
BUNGIE_CLIENT_ID=your_bungie_client_id_here
BUNGIE_CLIENT_SECRET=your_bungie_client_secret_here
BUNGIE_API_KEY=your_bungie_api_key_here

# OAuth Redirect URI (update for your environment)
# Development: http://localhost:3000/auth/callback
# Production: https://yourdomain.com/auth/callback
AUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_DAYS=30

# Database Configuration (for future use)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=guardian_tracker
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_SSL_MODE=disable

# Redis Configuration (for session/cache management)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# Internal API Key (for service-to-service communication)
# Used by bungie-service to fetch Bungie OAuth tokens
INTERNAL_API_KEY=your_internal_api_key_change_in_production

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
