# Bungie Service Configuration

# Server Configuration
PORT=8082
GO_ENV=development

# Bungie API Configuration
BUNGIE_API_KEY=your_bungie_api_key_here
BUNGIE_API_BASE_URL=https://www.bungie.net/Platform

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_SECOND=10
RATE_LIMIT_BURST=20

# Caching Configuration
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Database Configuration (for future use)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=guardian_tracker
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_SSL_MODE=disable

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Timeout Configuration
HTTP_TIMEOUT_SECONDS=30
