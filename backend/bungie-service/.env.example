# Bungie Service Configuration

# Server Configuration
PORT=8082
GO_ENV=development

# Bungie API Configuration
BUNGIE_API_KEY=your_bungie_api_key_here
BUNGIE_API_BASE_URL=https://www.bungie.net/Platform

# Rate Limiting (requests per second to Bungie API)
BUNGIE_API_RPS=10
BUNGIE_API_BURST=20

# Manifest Configuration
MANIFEST_DB_PATH=./data/manifest.sqlite
MANIFEST_CHECK_INTERVAL=3600

# Caching Configuration
CACHE_ENABLED=true
CACHE_TTL_COLLECTIONS=300
CACHE_TTL_MANIFEST=86400

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# Logging
LOG_LEVEL=info

# Timeout Configuration
HTTP_TIMEOUT_SECONDS=30
