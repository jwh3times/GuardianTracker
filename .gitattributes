# Normalize line endings: store text as LF in the repo, check out native on each OS.
* text=auto eol=lf

# Scripts that must keep platform-specific line endings
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.sh    text eol=lf

# Treat these as binary (no EOL conversion, no diff noise)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.sqlite binary
*.woff  binary
*.woff2 binary
