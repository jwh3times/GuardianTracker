# Frontend Configuration
# Note: Only variables prefixed with REACT_APP_ are accessible in React

# API Endpoints
REACT_APP_GRAPHQL_URL=http://localhost:4000/graphql
REACT_APP_AUTH_SERVICE_URL=http://localhost:8081

# OAuth Configuration
REACT_APP_AUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# Feature Flags
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_ENABLE_DEBUG_MODE=true

# Application Configuration
REACT_APP_NAME=Guardian Tracker
REACT_APP_VERSION=0.1.0
REACT_APP_ENVIRONMENT=development

# External Links
REACT_APP_BUNGIE_SIGNUP_URL=https://www.bungie.net/en/User/SignUp
REACT_APP_SUPPORT_EMAIL=support@guardiantracker.com
