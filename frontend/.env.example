# Frontend Configuration
# Only variables prefixed with VITE_ are accessible in the app (via import.meta.env)

# Dev tunnel host (optional) — exposes the Vite dev server through ngrok/Cloudflare,
# e.g. for Bungie OAuth over HTTPS. Read by vite.config.ts (not exposed to the app).
# NGROK_HOST=your-tunnel.ngrok-free.dev

# API Endpoint (default: http://localhost:8081)
VITE_API_URL=http://localhost:8081

# Tunnel OAuth callback (optional, development only). When Bungie's redirect URI
# is an HTTPS tunnel but you sign in from http://localhost:5273, set this to that
# local origin: the callback forwards there so sign-in can complete. Leave unset
# otherwise. The Docker frontend takes it as a build argument instead (see the
# root .env.example).
# VITE_OAUTH_COMPLETION_ORIGIN=http://localhost:5273
