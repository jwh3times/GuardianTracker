# Frontend Configuration
# Only variables prefixed with VITE_ are accessible in the app (via import.meta.env)

# Dev tunnel host (optional) — exposes the Vite dev server through ngrok/Cloudflare,
# e.g. for Bungie OAuth over HTTPS. Read by vite.config.ts (not exposed to the app).
# NGROK_HOST=your-tunnel.ngrok-free.dev

# API Endpoints
VITE_GRAPHQL_URL=http://localhost:4000/graphql
VITE_AUTH_SERVICE_URL=http://localhost:8081

# OAuth Configuration
VITE_AUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG_MODE=true

# Application Configuration
VITE_NAME=Guardian Tracker
VITE_VERSION=0.1.0
VITE_ENVIRONMENT=development

# External Links
VITE_BUNGIE_SIGNUP_URL=https://www.bungie.net/en/User/SignUp
VITE_SUPPORT_EMAIL=support@guardiantracker.com
