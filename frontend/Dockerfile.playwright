ARG NODE_IMAGE=node:26.12.1-bookworm-slim@sha256:28147155d47dc31abe0a46e0d12b59b2fb3d0a2dcc5dc65fce76a074180b16fe
ARG PLAYWRIGHT_IMAGE=mcr.microsoft.com/playwright:v1.64.1-noble@sha256:47b510dd9230bf0b9bfc9b20102241e577ea7a99334ab4c3ca19f19770e9b8ea

FROM ${NODE_IMAGE} AS node-runtime
FROM ${PLAYWRIGHT_IMAGE}

# Playwright pins the browsers and system libraries, while the project pins the
# Node runtime. Keep Node under /opt so the Playwright image remains otherwise
# unchanged and npm's relative symlinks continue to resolve.
COPY --from=node-runtime /usr/local/ /opt/node/
ENV PATH="/opt/node/bin:${PATH}"

RUN node --version && npm --version
