# Dependencies
node_modules/
*/node_modules/
vendor/
*/vendor/

# Build outputs
dist/
build/
*/dist/
*/build/

# Environment files (NEVER commit real credentials)
# Ignores .env and any .env.<suffix> at any depth, but keeps the .env.example templates.
.env
.env.*
!.env.example

# Secrets & certificates (NEVER commit)
*.pem
*.key
*.crt
*.p12
*.pfx

# Kubernetes secrets (NEVER commit)
k8s/*-secret.yaml
k8s/secrets/
*.secrets.yaml

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database
*.db
*.sqlite

# Bungie manifest data (large, runtime-downloaded; ~290MB sqlite exceeds GitHub's 100MB limit)
backend/bungie-service/data/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Go specific
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
go.work

# Docker
docker-compose.override.yml

# Terraform
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# AWS
.aws/

# Testing
coverage/
*.cover
*.coverprofile

# TypeScript incremental build cache
*.tsbuildinfo

# Temporary files
tmp/
temp/
.tmp/

# Local development
.air.toml

# Private files
private/
