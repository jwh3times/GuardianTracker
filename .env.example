# Root .env file for docker-compose

# Environment
ENVIRONMENT=development

# Service Ports (host-side; container ports never change). These are offset from
# the canonical 5432/5050/8080 so the stack coexists with other local projects.
# See README.md → Ports.
API_SERVICE_PORT=8081
FRONTEND_PORT=5273
PGADMIN_PORT=5150
PGADMIN_EMAIL=admin@guardiantracker.gg
PGADMIN_PASSWORD=admin
# Throwaway Postgres for the Go test suite (profile: test); sits next to 5532.
TEST_POSTGRES_PORT=5533

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5532
POSTGRES_DB=guardian_tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# Redis Configuration
# Redis is in docker-compose but not currently used by the API service
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Bungie API Configuration
BUNGIE_CLIENT_ID=your_bungie_client_id_here
BUNGIE_CLIENT_SECRET=your_bungie_client_secret_here
BUNGIE_API_KEY=your_bungie_api_key_here

# JWT Configuration (keep this secure!)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_minimum_32_characters

# OAuth Configuration — must match the frontend host port (FRONTEND_PORT) AND the
# redirect URI registered in your Bungie application settings.
AUTH_REDIRECT_URI=http://localhost:5273/auth/callback

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5273

# Token encryption (generate with: openssl rand -base64 32)
TOKEN_ENCRYPTION_KEY=
# Previous encryption key (only needed during key rotation)
TOKEN_ENCRYPTION_KEY_PREVIOUS=

# Admin bootstrap — comma-separated Bungie membership IDs pinned to the admin
# role on every login. The only way to mint the first admin; additional admins
# are then granted from the in-app Admin Console. Leave empty for no bootstrap.
ADMIN_MEMBERSHIP_IDS=
