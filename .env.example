# Root .env file for docker-compose

# Environment
ENVIRONMENT=development

# Service Ports
API_SERVICE_PORT=8081
FRONTEND_PORT=3000

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=guardian_tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# Redis Configuration
# Redis is in docker-compose but not currently used by the API service
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Bungie API Configuration
BUNGIE_CLIENT_ID=your_bungie_client_id_here
BUNGIE_CLIENT_SECRET=your_bungie_client_secret_here
BUNGIE_API_KEY=your_bungie_api_key_here

# JWT Configuration (keep this secure!)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_minimum_32_characters

# OAuth Configuration
AUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Token encryption (generate with: openssl rand -base64 32)
TOKEN_ENCRYPTION_KEY=
# Previous encryption key (only needed during key rotation)
TOKEN_ENCRYPTION_KEY_PREVIOUS=

# Admin bootstrap — comma-separated Bungie membership IDs pinned to the admin
# role on every login. The only way to mint the first admin; additional admins
# are then granted from the in-app Admin Console. Leave empty for no bootstrap.
ADMIN_MEMBERSHIP_IDS=
