# Root .env file for docker-compose and shared configuration

# Environment
ENVIRONMENT=development

# Service Ports
AUTH_SERVICE_PORT=8081
BUNGIE_SERVICE_PORT=8082
GRAPHQL_SERVICE_PORT=4000
FRONTEND_PORT=3000

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=guardian_tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Bungie API Configuration (shared across services)
BUNGIE_CLIENT_ID=your_bungie_client_id_here
BUNGIE_CLIENT_SECRET=your_bungie_client_secret_here
BUNGIE_API_KEY=your_bungie_api_key_here

# JWT Configuration (shared secret - keep this secure!)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_minimum_32_characters

# Internal API Key (shared between auth-service and bungie-service for service-to-service auth)
INTERNAL_API_KEY=dev-internal-key

# OAuth Configuration
AUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=info
