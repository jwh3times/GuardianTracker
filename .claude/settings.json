{
  "permissions": {
    "allow": [
      "Bash(npm run test:policy)",
      "Bash(npm run sync:agents:check)",
      "Bash(npm run lint:agents)",
      "Bash(npm run test:go-toolchain-policy)",
      "Bash(npm run test:workspace-portability)",
      "Bash(npm run test:docker-context)",
      "Bash(npm run test:nginx-headers)",
      "Bash(npm run board:blockers)",
      "Bash(npm run sync:image-pins -- --check)",
      "Bash(npm run type-check)",
      "Bash(npm run lint)",
      "Bash(npm run format:check)",
      "Bash(npm run build)",
      "Bash(npm run test:coverage)",
      "Bash(npm run e2e)",
      "Bash(npm run e2e:functional)",
      "Bash(npm run e2e:a11y)",
      "Bash(npm run e2e:visual)",
      "Bash(npm test)",
      "Bash(npm test -- --coverage)",
      "Bash(npm ci)",
      "Bash(go run honnef.co/go/tools/cmd/staticcheck@2026.1 ./...)",
      "Bash(GOTOOLCHAIN=go1.26.11 go run honnef.co/go/tools/cmd/staticcheck@2026.1 ./...)",
      "Bash(go test ./...)",
      "Bash(go test -race ./...)",
      "Bash(go test -coverprofile=coverage.out ./...)",
      "Bash(go test -race -coverprofile=coverage.out ./...)",
      "Bash(go vet ./...)",
      "Bash(go build ./...)",
      "Bash(docker compose up --build)",
      "Bash(docker compose up -d)",
      "Bash(docker compose --profile e2e up -d --wait e2e-postgres)",
      "Bash(docker compose stop)",
      "Bash(docker compose stop frontend api-service)",
      "Bash(docker compose down)",
      "Bash(docker compose --profile test down)",
      "Bash(docker compose --profile e2e down)",
      "Bash(docker compose ps)",
      "Bash(docker compose ps *)",
      "Bash(docker compose --profile test --profile e2e ps)",
      "Bash(docker compose --profile test --profile e2e ps *)",
      "Bash(docker compose logs *)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch)",
      "Bash(git fetch *)",
      "Bash(git merge-base *)",
      "Bash(gh project item-list *)",
      "Bash(gh project field-list *)",
      "Bash(npx vitest run)",
      "Bash(npx vitest run --coverage)",
      "Bash(npx prettier --check *)",
      "mcp__context7__query-docs",
      "mcp__context7__resolve-library-id"
    ],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/guard.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/guard.mjs",
              "--post"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
